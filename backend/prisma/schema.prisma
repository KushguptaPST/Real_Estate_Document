// Contingency Deadline Copilot — Prisma Schema
// Database: PostgreSQL 16
// Run: npx prisma migrate dev (dev) | npx prisma migrate deploy (prod)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organization / Multi-Tenancy Boundary ────────────────────────────────────
model Organization {
  id                   String       @id @default(cuid())
  name                 String
  subscriptionTier     String       @default("SOLO")
  subscriptionStatus   String       @default("ACTIVE")
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  planExpiresAt        DateTime?
  stateJurisdiction    String?      @default("CA")
  isSuspended          Boolean      @default(false)
  suspendedReason      String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  users               User[]
  leads               Lead[]
  properties          Property[]
  deals               Deal[]
  kbDocuments         KBDocument[]
  conversationThreads ConversationThread[]
  webhookEvents       WebhookEvent[]
  invitations         Invitation[]
  apiKeys             OrganizationApiKey[]
  callLogs            LeadCallLog[]
  leadTasks           LeadTask[]
  siteVisits          SiteVisit[]
  channels            OrganizationChannel?
  plivoNumbers        PlivoNumber[]
  campaigns           Campaign[]
  campaignEnrollments CampaignEnrollment[]
  voiceCallSessions   VoiceCallSession[]
  agentRunTraces      AgentRunTrace[]
  wallet              OrganizationWallet?
  marketAdjacencies   MicroMarketAdjacency[]
  providerCostEvents  ProviderCostEvent[]
  adminAuditLogs      AdminAuditLog[]

  @@map("organizations")
}

// ─── User ─────────────────────────────────────────────────────────────────────
enum UserRole {
  OWNER
  AGENT
}

model User {
  id             String        @id @default(cuid())
  googleId       String?       @unique
  email          String        @unique
  passwordHash   String?
  name           String?
  phone          String?
  pictureUrl     String?
  organizationId String?
  role           UserRole      @default(AGENT)
  // Bumped on role change / removal so previously issued session tokens stop working.
  sessionVersion Int           @default(0)
  lastLoginAt    DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization        Organization?           @relation(fields: [organizationId], references: [id])
  assignedLeads       Lead[]
  previousAssignments LeadAssignmentHistory[] @relation("PreviousLeadAssignments")
  currentAssignments  LeadAssignmentHistory[] @relation("CurrentLeadAssignments")
  authoredAssignments LeadAssignmentHistory[] @relation("LeadAssignmentAuthor")
  loggedCalls         LeadCallLog[]
  assignedLeadTasks   LeadTask[]              @relation("LeadTaskAssignee")
  createdLeadTasks    LeadTask[]              @relation("LeadTaskCreator")
  completedLeadTasks  LeadTask[]              @relation("LeadTaskCompleter")
  assignedSiteVisits  SiteVisit[]             @relation("SiteVisitAssignee")
  createdSiteVisits   SiteVisit[]             @relation("SiteVisitCreator")
  cancelledSiteVisits SiteVisit[]             @relation("SiteVisitCanceller")
  completedSiteVisits SiteVisit[]             @relation("SiteVisitCompleter")
  noShowSiteVisits    SiteVisit[]             @relation("SiteVisitNoShower")

  @@index([organizationId])
  @@map("users")
}

// ─── Invitation (invite-only organization membership) ───────────────────────
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           UserRole  @default(AGENT)
  // SHA-256 of the one-time invite token; the plaintext token is never stored.
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

// ─── Organization API Key (server-to-server lead intake) ────────────────────
model OrganizationApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyPrefix      String
  // SHA-256 of the full key; the plaintext key is shown once at creation.
  keyHash        String    @unique
  scope          String    @default("lead_intake")
  createdById    String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_api_keys")
}

// ─── Lead & Lead Requirements ────────────────────────────────────────────────
model Lead {
  id                String             @id @default(cuid())
  organizationId    String?
  source            LeadSource         @default(WEBSITE_FORM)
  externalId        String?
  fullName          String
  email             String?
  phone             String?
  status            LeadStatus         @default(NEW)
  stage             LeadLifecycleStage @default(NEW_INBOUND)
  priority          LeadPriority       @default(MEDIUM)
  doNotCall         Boolean            @default(false)
  preferredLanguage String?
  assignedUserId    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization        Organization?              @relation(fields: [organizationId], references: [id])
  assignedUser        User?                      @relation(fields: [assignedUserId], references: [id])
  requirements        LeadRequirement?
  proposals           LeadRequirementProposal[]
  conversations       ConversationThread[]
  matches             PropertyMatch[]
  deal                Deal?
  assignmentHistory   LeadAssignmentHistory[]
  callLogs            LeadCallLog[]
  tasks               LeadTask[]
  siteVisits          SiteVisit[]
  campaignEnrollments CampaignEnrollment[]
  voiceCallSessions   VoiceCallSession[]
  agentRunTraces      AgentRunTrace[]

  @@index([organizationId, status])
  @@index([organizationId, stage])
  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([email, phone])
  @@map("leads")
}

enum LeadSource {
  WEBSITE_FORM
  PORTAL_INQUIRY
  WHATSAPP
  TELEGRAM
  VOICE_CALL
  WEB_WIDGET
  CSV_CAMPAIGN
  EMAIL
  MANUAL
}

enum LeadLifecycleStage {
  NEW_INBOUND
  DISCOVERY
  MATCHED
  COLLATERAL_SENT
  VISIT_PROPOSED
  VISIT_BOOKED
  ADVISOR_HANDOFF
  DEAL_NEGOTIATION
  NURTURE
  DISQUALIFIED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model LeadRequirement {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  minBudget          Float?
  maxBudget          Float?
  preferredLocations String[]
  propertyType       String?
  minBedrooms        Int?
  maxBedrooms        Int?
  possessionTimeline String?
  notes              String?  @db.Text
  rawAiExtraction    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_requirements")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFIED
}

model LeadRequirementProposal {
  id                  String         @id @default(cuid())
  leadId              String
  organizationId      String?
  proposedMinBudget   Float?
  proposedMaxBudget   Float?
  proposedLocations   String[]
  proposedPropertyType String?
  proposedMinBedrooms Int?
  proposedMaxBedrooms Int?
  proposedTimeline    String?
  confidence          Float?
  sourceMessageId     String?
  status              ProposalStatus @default(PENDING)
  createdAt           DateTime       @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@index([organizationId])
  @@map("lead_requirement_proposals")
}

model LeadAssignmentHistory {
  id             String   @id @default(cuid())
  leadId         String
  organizationId String
  previousUserId String?
  assignedUserId String?
  changedById    String?
  reason         String?
  createdAt      DateTime @default(now())

  lead         Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousUser User? @relation("PreviousLeadAssignments", fields: [previousUserId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("CurrentLeadAssignments", fields: [assignedUserId], references: [id], onDelete: SetNull)
  changedBy    User? @relation("LeadAssignmentAuthor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([organizationId])
  @@index([assignedUserId])
  @@map("lead_assignment_history")
}

// ─── Lead Call Logs ───────────────────────────────────────────────────────────
enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  BUSY
  CALLBACK_REQUESTED
  VOICEMAIL
  WRONG_NUMBER
  OTHER
}

model LeadCallLog {
  id              String        @id @default(cuid())
  leadId          String
  organizationId  String
  userId          String
  direction       CallDirection
  outcome         CallOutcome
  calledAt        DateTime      @default(now())
  durationSeconds Int?
  notes           String?       @db.Text
  followUpNeeded  Boolean       @default(false)
  followUpDate    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpTask LeadTask?

  @@index([leadId, calledAt])
  @@index([organizationId, calledAt])
  @@index([userId])
  @@map("lead_call_logs")
}

// ─── Lead Follow-Up Tasks ───────────────────────────────────────────────────
enum LeadTaskType {
  CALL
  MESSAGE
  SITE_VISIT
  SEND_DETAILS
  DOCUMENT_FOLLOW_UP
  OTHER
}

enum LeadTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model LeadTask {
  id             String         @id @default(cuid())
  leadId         String
  organizationId String
  taskType       LeadTaskType   @default(CALL)
  title          String
  description    String?        @db.Text
  dueDate        DateTime
  status         LeadTaskStatus @default(OPEN)
  priority       LeadPriority   @default(MEDIUM)
  assignedUserId String
  createdById    String
  completedAt    DateTime?
  completedById  String?
  callLogId      String?        @unique
  siteVisitId    String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser  User          @relation("LeadTaskAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)
  createdByUser User          @relation("LeadTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  completedUser User?         @relation("LeadTaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  callLog       LeadCallLog?  @relation(fields: [callLogId], references: [id], onDelete: SetNull)
  siteVisit     SiteVisit?    @relation(fields: [siteVisitId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([assignedUserId, status, dueDate])
  @@index([leadId, status])
  @@index([callLogId])
  @@index([siteVisitId])
  @@map("lead_tasks")
}

// ─── Multi-Channel Conversation & Controlled State Machine ───────────────────
enum ConversationState {
  AUTOPILOT
  DRAFT_ONLY
  HUMAN_TAKEOVER
  PAUSED
  CLOSED
}

model ConversationThread {
  id               String            @id @default(cuid())
  leadId           String
  organizationId   String?
  channel          MessageChannel    @default(EMAIL)
  state            ConversationState @default(AUTOPILOT)
  isHumanTakeover  Boolean           @default(false)
  takeoverBy       String?
  autoReplyEnabled Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lead         Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organization Organization?         @relation(fields: [organizationId], references: [id])
  messages     ConversationMessage[]

  @@index([leadId])
  @@index([organizationId])
  @@map("conversation_threads")
}

enum MessageChannel {
  EMAIL
  WHATSAPP
  TELEGRAM
  VOICE_CALL
  WEB_WIDGET
  SMS
  WEB_CHAT
}

model ConversationMessage {
  id                String          @id @default(cuid())
  threadId          String
  organizationId    String?
  senderType        SenderType
  senderId          String?
  content           String          @db.Text
  suggestedAction   Json?
  approvalStatus    ApprovalStatus  @default(APPROVED)
  deliveryStatus    DeliveryStatus  @default(NOT_APPLICABLE)
  deliveredAt       DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  providerMessageId String?
  deliveryError     String?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())

  thread    ConversationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  outboxJob OutboxJob?

  @@index([threadId])
  @@index([organizationId])
  @@index([providerMessageId])
  @@index([deliveryStatus])
  @@map("conversation_messages")
}

enum DeliveryStatus {
  NOT_APPLICABLE
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  RETRY_PENDING
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model OutboxJob {
  id                String         @id @default(cuid())
  organizationId    String?
  messageId         String         @unique
  recipientEmail    String
  channel           MessageChannel @default(EMAIL)
  payload           Json
  idempotencyKey    String         @unique
  status            OutboxStatus   @default(PENDING)
  attempts          Int            @default(0)
  maxAttempts       Int            @default(3)
  nextAttemptAt     DateTime       @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  lastError         String?
  providerMessageId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organizationId])
  @@index([providerMessageId])
  @@map("outbox_jobs")
}

enum SenderType {
  CUSTOMER
  AGENT
  AI
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED
}

// ─── Property Inventory & Matching ──────────────────────────────────────────
model Property {
  id                    String         @id @default(cuid())
  organizationId        String?
  title                 String
  address               String
  city                  String
  microMarket           String?
  builderName           String?
  reraNumber            String?
  possessionStatus      String?
  price                 Float
  bedrooms              Int
  bathrooms             Float
  propertyType          String
  status                PropertyStatus @default(AVAILABLE)
  possessionDate        DateTime?
  features              String[]
  description           String?        @db.Text
  brochureUrl           String?
  floorPlanUrl          String?
  mapsUrl               String?
  latitude              Float?
  longitude             Float?
  negotiationMarginNote String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization?   @relation(fields: [organizationId], references: [id])
  matches      PropertyMatch[]
  siteVisits   SiteVisit[]
  deals        Deal[]

  @@index([organizationId, price, bedrooms, status])
  @@map("properties")
}

enum PropertyStatus {
  AVAILABLE
  UNDER_CONTRACT
  SOLD
  OFF_MARKET
}

model PropertyMatch {
  id                     String   @id @default(cuid())
  leadId                 String
  propertyId             String
  organizationId         String?
  matchScore             Float
  aiExplanationConfidence Float?
  matchReason            String   @db.Text
  failedCriteria         String[]
  createdAt              DateTime @default(now())

  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([leadId, propertyId])
  @@index([organizationId])
  @@map("property_matches")
}

// ─── Transaction Tasks & Proposal Review Queue ──────────────────────────────
model TransactionTask {
  id               String     @id @default(cuid())
  dealId           String
  organizationId   String?
  title            String
  description      String?    @db.Text
  dueDate          DateTime
  amount           Float?
  assignedTo       String?
  isHumanReviewed  Boolean    @default(false)
  status           TaskStatus @default(PENDING)
  sourceDocumentId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, status])
  @@index([organizationId])
  @@map("transaction_tasks")
}

model TaskProposal {
  id              String         @id @default(cuid())
  dealId          String
  organizationId  String?
  sourceDocumentId String?
  title           String
  description     String?        @db.Text
  proposedDueDate DateTime
  proposedAmount  Float?
  sourceQuote     String?
  sourcePage      Int?
  confidence      Float?
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, status])
  @@index([organizationId])
  @@map("task_proposals")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

// ─── Webhook Event Logging & Idempotency ────────────────────────────────────
model WebhookEvent {
  id              String        @id @default(cuid())
  provider        String
  organizationId  String?
  externalEventId String
  eventType       String
  payload         Json
  status          String        @default("PENDING")
  error           String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([provider, externalEventId])
  @@index([organizationId, provider])
  @@map("webhook_events")
}

// ─── Knowledge Base Documents ────────────────────────────────────────────────
model KBDocument {
  id             String      @id @default(cuid())
  organizationId String?
  title          String
  category       String
  storagePath    String
  indexStatus    IndexStatus @default(PENDING)
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("kb_documents")
}

// ─── Deal ─────────────────────────────────────────────────────────────────────
model Deal {
  id               String      @id @default(cuid())
  organizationId   String?
  leadId           String?     @unique
  propertyId       String?
  propertyAddress  String
  buyerName        String?
  sellerName       String?
  acceptanceDate   DateTime?
  status           DealStatus  @default(ACTIVE)
  timezone         String      @default("America/New_York")
  inboundAlias     String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization         Organization?           @relation(fields: [organizationId], references: [id])
  lead                 Lead?                   @relation(fields: [leadId], references: [id])
  property             Property?               @relation(fields: [propertyId], references: [id])
  documents            Document[]
  clauses              ContingencyClause[]
  deadlines            Deadline[]
  tasks                TransactionTask[]
  taskProposals        TaskProposal[]
  auditLogs            AuditLog[]
  chunks               DocumentChunk[]
  conversations        AssistantConversation[]
  notificationSettings NotificationSetting?
  emailLogs            EmailLog[]

  @@index([organizationId])
  @@index([propertyId])
  @@map("deals")
}

enum DealStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

// ─── Document ─────────────────────────────────────────────────────────────────
model Document {
  id            String      @id @default(cuid())
  dealId        String
  organizationId String?
  filename      String
  storagePath   String
  mimeType      String      @default("application/pdf")
  sizeBytes     Int?
  docType       DocType     @default(OTHER)
  effectiveDate DateTime?
  pageCount     Int?
  indexStatus   IndexStatus @default(PENDING)
  indexedAt     DateTime?
  uploadedAt    DateTime    @default(now())

  deal    Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clauses ContingencyClause[]
  chunks  DocumentChunk[]

  @@index([dealId])
  @@index([organizationId])
  @@map("documents")
}

enum DocType {
  PURCHASE_AGREEMENT
  COUNTER_OFFER
  ADDENDUM
  INSPECTION_REPORT
  HOA_DISCLOSURE
  TITLE_COMMITMENT
  OTHER
}

enum IndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

// ─── DocumentChunk ────────────────────────────────────────────────────────────
model DocumentChunk {
  id           String      @id @default(cuid())
  documentId   String
  dealId       String
  organizationId String?
  pageNumber   Int
  chunkIndex   Int
  sectionTitle String?
  content      String      @db.Text
  tokenCount   Int?
  source       ChunkSource @default(text)
  embedding    Json?
  createdAt    DateTime    @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, documentId])
  @@index([dealId, pageNumber])
  @@index([organizationId])
  @@map("document_chunks")
}

enum ChunkSource {
  text
  ocr
}

// ─── AssistantConversation & Messages ─────────────────────────────────────────
model AssistantConversation {
  id             String             @id @default(cuid())
  dealId         String
  organizationId String?
  userId         String?
  title          String             @default("New Conversation")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  deal     Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([dealId])
  @@index([organizationId])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id                 String                @id @default(cuid())
  conversationId     String
  organizationId     String?
  role               String
  content            String                @db.Text
  citations          Json?
  suggestedFollowUps Json?
  createdAt          DateTime              @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([organizationId])
  @@map("assistant_messages")
}

// ─── NotificationSetting & EmailLog ───────────────────────────────────────────
model NotificationSetting {
  id           String   @id @default(cuid())
  dealId       String   @unique
  organizationId String?
  recipients   Json
  window3d     Boolean  @default(true)
  window1d     Boolean  @default(true)
  windowDayOf  Boolean  @default(true)
  windowMissed Boolean  @default(true)
  enabled      Boolean  @default(true)
  timezone     String   @default("America/New_York")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_settings")
}

model EmailLog {
  id                String      @id @default(cuid())
  dealId            String
  organizationId    String?
  deadlineId        String?
  recipient         String
  template          String
  status            EmailStatus @default(SENT)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime    @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([deadlineId, template])
  @@index([dealId])
  @@index([organizationId])
  @@map("email_logs")
}

enum EmailStatus {
  SENT
  DELIVERED
  BOUNCED
  DROPPED
}

// ─── ContingencyClause ────────────────────────────────────────────────────────
model ContingencyClause {
  id           String      @id @default(cuid())
  dealId       String
  documentId   String
  organizationId String?
  clauseType   String
  rawText      String      @db.Text
  pageNumber   Int?
  boundingBox  Json?
  confidence   Float?
  numberOfDays Int?
  dayType      DayType?
  createdAt    DateTime    @default(now())

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  deadline Deadline?

  @@index([organizationId])
  @@map("contingency_clauses")
}

enum DayType {
  calendar
  business
}

// ─── Deadline ─────────────────────────────────────────────────────────────────
model Deadline {
  id             String         @id @default(cuid())
  dealId         String
  organizationId String?
  clauseId       String         @unique
  label          String
  computedDate   DateTime
  confirmedDate  DateTime?
  dayType        DayType        @default(calendar)
  status         DeadlineStatus @default(PENDING)
  confirmedBy    String?
  confirmedAt    DateTime?
  alertSentAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  deal   Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  clause ContingencyClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("deadlines")
}

enum DeadlineStatus {
  PENDING
  CONFIRMED
  ACTIVE
  MISSED
  COMPLETED
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
model AuditLog {
  id             String      @id @default(cuid())
  dealId         String?
  organizationId String?
  action         AuditAction
  entityType     String?
  entityId       String?
  previousValue  Json?
  newValue       Json?
  actor          String?
  note           String?
  createdAt      DateTime    @default(now())

  deal Deal? @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("audit_logs")
