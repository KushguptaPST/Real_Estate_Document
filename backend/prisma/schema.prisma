enum AuditAction {
  DOCUMENT_UPLOADED
  EXTRACTION_STARTED
  EXTRACTION_COMPLETED
  DEADLINE_CONFIRMED
  DEADLINE_EDITED
  DEADLINE_ACTIVATED
