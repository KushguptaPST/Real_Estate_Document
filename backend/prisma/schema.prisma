  HUMAN_TAKEOVER_TOGGLED
  PROPERTY_CREATED
  PROPERTY_MATCHED
  TASK_EXTRACTED
  TASK_APPROVED
  TASK_COMPLETED
  CALL_LOGGED
  LEAD_TASK_CREATED
  LEAD_TASK_UPDATED
  LEAD_TASK_COMPLETED
  LEAD_TASK_CANCELLED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_RESCHEDULED
  SITE_VISIT_CANCELLED
