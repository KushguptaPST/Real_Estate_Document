# ─────────────────────────────────────────────────────────────────────────────
# Contingency Deadline Copilot — Environment Variables
# Copy this file to backend/.env and fill in real values.
# Add VITE_* vars to frontend/.env.local
# NEVER commit .env files with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ──────────────────────────
# Local Docker:   postgresql://copilot:copilot@localhost:5432/copilot_dev
# Remote (Neon/Railway/Supabase): paste connection string here
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot_dev

# ── Auth — Google Sign-In ─────────────────────────────────────
# OAuth client from https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret used to sign session tokens — generate with: openssl rand -hex 32
# Required: random, >= 32 chars (e.g. `openssl rand -hex 32`). The server refuses to start otherwise.
JWT_SECRET=
# Dev-only sandbox login (separate demo org). Ignored/refused when NODE_ENV=production.
ENABLE_DEMO_LOGIN=false
# Base URL used in invitation links
APP_URL=http://localhost:5173
# Frontend origin(s) allowed by CORS, comma-separated. Localhost origins are added automatically outside production.
CORS_ORIGIN=http://localhost:3000

# ── File Storage ──────────────────────────────────────────────
# STORAGE_DRIVER=local uses backend/uploads on disk. Set to "imagekit" to
# upload documents to ImageKit's media library / CDN instead.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ImageKit (production file storage — https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/contingency-copilot

# ── AI / Gemini & Assistant ────────────────────────────────────
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
ASSISTANT_TOP_K=6
ASSISTANT_FULL_CONTEXT_TOKENS=120000
ASSISTANT_RATE_LIMIT=30

# ── Alerts — Twilio SMS ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Alerts & Outbound Messaging — Email (Resend / SendGrid) ──
EMAIL_DRIVER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Resend / Svix signing secret (from Resend Webhooks Dashboard)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SendGrid Event Webhook secret / signature key
SENDGRID_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Contingency Copilot <onboarding@resend.dev>
FROM_EMAIL=onboarding@resend.dev
ALERT_CRON=0 * * * *
DEFAULT_TIMEZONE=America/New_York

# ── Inbound Email Parse ───────────────────────────────────────
# (unused — superseded by INBOUND_WEBHOOK_SECRET)
INBOUND_PARSE_SECRET=
INBOUND_EMAIL_DOMAIN=deals.yourdomain.com
# Shared secret for SendGrid Inbound Parse (multipart). Endpoint returns 503 when unset.
INBOUND_WEBHOOK_SECRET=
# HMAC-SHA256 signing secret for the signed JSON inbound-lead webhook. Endpoint returns 503 when unset.
EMAIL_WEBHOOK_SECRET=

# ── Payments — Stripe ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Frontend (Vite public vars) — add to frontend/.env.local
VITE_API_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=
