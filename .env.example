# ─────────────────────────────────────────────────────────────────────────────
# Contingency Deadline Copilot — Environment Variables
# Copy this file to backend/.env and fill in real values.
# Add VITE_* vars to frontend/.env.local
# NEVER commit .env files with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL via Prisma) ──────────────────────────
# Local Docker:   postgresql://copilot:copilot@localhost:5432/copilot_dev
# Remote (Neon/Railway/Supabase): paste connection string here
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot_dev

# ── Auth — Google Sign-In ─────────────────────────────────────
# OAuth client from https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Secret used to sign session tokens — generate with: openssl rand -hex 32
JWT_SECRET=
# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Comma-separated emails allowed to access /api/admin (Platform Super-Admin Mission Control)
PLATFORM_ADMIN_EMAILS=

# ── File Storage ──────────────────────────────────────────────
# STORAGE_DRIVER=local uses backend/uploads on disk. Set to "imagekit" to
# upload documents to ImageKit's media library / CDN instead.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ImageKit (production file storage — https://imagekit.io/dashboard/developer/api-keys)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/contingency-copilot

# ── AI / Gemini & Assistant ────────────────────────────────────
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
ASSISTANT_TOP_K=6
ASSISTANT_FULL_CONTEXT_TOKENS=120000
ASSISTANT_RATE_LIMIT=30

# ── Telephony — Plivo Voice API & Bidirectional Streaming ─────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_STREAM_BASE_URL=
DEEPGRAM_API_KEY=

# ── Alerts — Email (Gmail / Brevo SMTP, Resend, or SendGrid) ───
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
FROM_EMAIL=noreply@yourdomain.com
ALERT_CRON=0 * * * *
DEFAULT_TIMEZONE=America/New_York

# ── Inbound Email Parse ───────────────────────────────────────
INBOUND_PARSE_SECRET=
INBOUND_EMAIL_DOMAIN=deals.yourdomain.com
INBOUND_WEBHOOK_SECRET=

# ── Payments — Razorpay (Primary India) & Stripe ──────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Meta WhatsApp Business Cloud API & Tech/Solution Partner ──
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_CREDIT_LINE_ID=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=contingency_copilot_meta_webhook_secret

# ── Voice Engine & 5 Acoustic Pillars ─────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ── Frontend (Vite public vars) — add to frontend/.env.local
VITE_API_URL=http://localhost:3001/api
VITE_GOOGLE_CLIENT_ID=
